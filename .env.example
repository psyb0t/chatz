# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Logging (slog-configurator)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=true

# HTTP (public API + embedded SPA). Metrics + pprof are internal-only ports.
CHATZ_HTTP_LISTENADDRESS=:8080
CHATZ_HTTP_PORT=8080
CHATZ_METRICS_LISTENADDRESS=:9091
CHATZ_PROFILING_LISTENADDRESS=:6060

# Database. `make run` uses Postgres by default. Set `CHATZ_DB_DRIVER=sqlite`
# for one local, single-process Chatz instance backed by the persistent Docker
# `/data` volume; it does not start the Postgres dependency in that mode.
CHATZ_DB_DRIVER=postgres
# SQLite only: an absolute regular file directly under `/data`. Keep this
# default for the hardened read-only image + named-volume deployment.
CHATZ_DB_SQLITE_PATH=/data/chatz.sqlite
CHATZ_DB_SQLITE_BUSY_TIMEOUT=5s

# Admin readiness reads a small marker written only after a successful backup.
# It must be an absolute regular file directly under /data; `24h` is the max
# accepted age before the admin page reports it stale.
CHATZ_BACKUP_STATUS_PATH=/data/chatz-backup-status.json
CHATZ_BACKUP_MAX_AGE=24h

# Postgres only. `make run` starts a postgres service and points the app at it
# via the compose network — you don't set DB_HOSTNAME for the docker stack.
# These values are for a HOST-side `go run` against your own postgres.
CHATZ_DB_HOSTNAME=localhost
CHATZ_DB_PORT=5432
CHATZ_DB_USERNAME=chatz
CHATZ_DB_PASSWORD=chatz
CHATZ_DB_NAME=chatz
CHATZ_DB_ISSSL=false

# Auth — sessions are opaque DB tokens (SESSION_SECRET is reserved for future
# CSRF/cookie-signing, not required yet). PASSWORDLESS auto-logs-in as the sole
# admin while exactly one user exists.
CHATZ_SESSION_SECRET=
CHATZ_AUTH_PASSWORDLESS=false
# Enables exact deterministic showcase-message interception; `make run-showcase`
# sets this for one local run without changing normal upstream or MCP behavior.
CHATZ_SHOWCASE_MODE=false

# SECRETS_KEY encrypts at-rest secrets (MCP HTTP headers + stdio env) with
# AES-256-GCM. Base64, exactly 32 bytes. Generate: openssl rand -base64 32
CHATZ_SECRETS_KEY=

# MCP servers are configured in the UI (admin) + stored in the DB, or imported
# from a Claude-style .mcp.json via the UI — no config file. Both stdio and
# remote-HTTP servers are allowed (the single admin is trusted).

# Upstreams: a JSON array selecting Elelem drivers. `provider` is `openai`
# (also used for OpenAI-compatible gateways such as Ollama) or `anthropic`.
# Every upstream names its driver explicitly. The app calls each
# provider's models endpoint and merges the discovered models. An optional
# `models` array attaches display aliases and known capabilities only to IDs
# the provider actually returns. Leave this empty to run the UI without LLMs.
# API keys are referenced by env name (apiKeyEnv), never stored inline. Add the
# matching variables below; Compose forwards this whole gitignored .env file.
# Chatz isolates every driver from the SDK's own provider environment fallback:
# each upstream uses only its apiKeyEnv value and its own optional baseUrl.
# CHATZ_UPSTREAMS=[{"name":"openai","provider":"openai","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY","models":[{"id":"analysis-model","alias":"Deep","contextWindow":128000,"maxOutputTokens":8192,"supportsTools":true,"supportsReasoning":true,"supportsFiles":true,"expectedFirstTokenLatencyMs":900,"inputPricePerMillionTokens":{"amountSmallestUnit":15,"currency":"USD"},"outputPricePerMillionTokens":{"amountSmallestUnit":60,"currency":"USD"}}]},{"name":"ollama","provider":"openai","baseUrl":"http://localhost:11434/v1"}]
CHATZ_UPSTREAMS=
# Optional discovered model ID used for new chats. Startup fails if no upstream
# advertises this ID; leave empty to have no instance default.
CHATZ_DEFAULT_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MY_GATEWAY_TOKEN=

# Bounds for every outbound LLM request. The connect limit bounds model
# discovery plus TCP/TLS connection setup for each provider request. The
# first-token and total-turn limits apply after an upstream request gets one
# of its own bounded concurrency slots.
CHATZ_UPSTREAM_CONNECT_TIMEOUT=10s
CHATZ_UPSTREAM_FIRST_TOKEN_TIMEOUT=45s
CHATZ_UPSTREAM_TURN_TIMEOUT=5m
CHATZ_UPSTREAM_CONCURRENCY=8

# Under `go test` every upstream resolves to elelem's scripted test double, so
# a unit or integration test can never reach a real provider by accident. Set
# this to true in your own .env to opt back in to real providers; `make
# test-real` forwards this file into the container, so that is how the real-LLM
# suite reaches a provider. Nothing in the repo flips it for you. Leave it false
# everywhere else; it has no effect outside tests.
CHATZ_FORCE_REAL_LLM=false

# Build metadata. Compose passes both values into the image build; the binary
# carries them onto the admin readiness page and every log line. GIT_COMMIT is
# also supplied at runtime as a fallback for a locally built binary.
CHATZ_APP_VERSION=dev
GIT_COMMIT=
